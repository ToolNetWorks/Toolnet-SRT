{
  "name": "jianying-subtitle",
  "version": "0.1.0",
  "description": "CLI tool to transcribe audio/video using JianYing (CapCut) free ASR API",
  "type": "module",
  "bin": {
    "jianying-subtitle": "./bin/jianying-subtitle.mjs"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./asr": "./dist/asr/jianying.js",
    "./subtitle": "./dist/subtitle/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "jianying",
    "capcut",
    "asr",
    "subtitle",
    "transcription",
    "speech-to-text",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
